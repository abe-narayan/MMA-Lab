{
  "name": "mma-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deterministic, replayable MMA-style bout simulator with a 3D broadcast viewer. Toy model - not a real-world predictor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/inline.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "batch": "tsx scripts/batch/run.ts",
    "calibrate:report": "tsx scripts/calibrate/report.ts",
    "golden:check": "tsx scripts/dev/sim-golden.ts --check tests/fixtures/sim-golden.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "author": "Abe",
  "keywords": [
    "simulation",
    "monte-carlo",
    "deterministic",
    "three.js",
    "replay",
    "sports-modelling"
  ]
}
